# Client (exposées au navigateur — la clé anon est publique par conception,
# ce sont les règles RLS de Supabase qui protègent les données)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Serveur uniquement (fonctions Vercel) — ne jamais préfixer par VITE_,
# ce préfixe embarque la valeur dans le JavaScript envoyé au navigateur.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
